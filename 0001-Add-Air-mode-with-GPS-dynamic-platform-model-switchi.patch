+/**
+ * Set the GPS dynamic platform model
+ * @param model The dynamic model to set (e.g., DYNMODEL_PORT, DYNMODEL_AIR4)
+ * @return true if successful, false otherwise
+ */
+bool GpsConnector::setDynamicModel(UbxDynamicModel model) {
+  // UBX-CFG-NAV5 message payload structure
+  // See u-blox protocol specification for details
+  uint8_t buffer[36]; // UBX-CFG-NAV5 payload is 36 bytes
+  
+  // Clear the buffer
+  memset(buffer, 0, sizeof(buffer));
+  
+  // Set the mask to only change the dynamic model
+  buffer[0] = 0x01; // mask LSB (dynModel)
+  buffer[1] = 0x00; // mask MSB
+  
+  // Set the dynamic model
+  buffer[2] = (uint8_t)model;
+  
+  // Send the UBX-CFG-NAV5 message
+  return _gnss.sendCommand(UBX_CLASS_CFG, UBX_ID_CFG_NAV5, buffer, sizeof(buffer));
+}
+
+/**
+ * Get the current GPS dynamic platform model
+ * @return The current dynamic model
+ */
+UbxDynamicModel GpsConnector::getDynamicModel() {
+  // Poll the current NAV5 configuration
+  if (!_gnss.sendCommand(UBX_CLASS_CFG, UBX_ID_CFG_NAV5, nullptr, 0)) {
+    // Failed to send poll request
+    return DYNMODEL_PORT; // Return default if failed
+  }
+  
+  // Wait for response (up to 100ms)
+  uint32_t startTime = millis();
+  while ((millis() - startTime) < 100) {
+    _gnss.checkUblox();
+    
+    // Check if we have a response
+    if (_gnss.packetCfg.cls == UBX_CLASS_CFG && 
+        _gnss.packetCfg.id == UBX_ID_CFG_NAV5 && 
+        _gnss.packetCfg.len >= 36) {
+      // Extract the dynamic model from the response
+      return (UbxDynamicModel)_gnss.packetCfg.payload[2];
+    }
+    
+    delay(1); // Small delay to prevent CPU hogging
+  }
+  
+  // Timeout or error
+  return DYNMODEL_PORT; // Return default if failed
+}
